{
  "id": "mallmate-suite-001",
  "version": "2.0",
  "name": "MallMate Selenium IDE Tests",
  "url": "http://localhost:8080/mallmate/",
  "tests": [
    {
      "id": "test-001",
      "name": "Open home and go to register",
      "commands": [
        { "id": "c1", "command": "open", "target": "/index.jsp", "value": "" },
        { "id": "c2", "command": "click", "target": "linkText=Register", "value": "" },
        { "id": "c3", "command": "assertTitle", "target": "Register - MallMate", "value": "" }
      ]
    },
    {
      "id": "test-002",
      "name": "Login form fill",
      "commands": [
        { "id": "c1", "command": "open", "target": "/login.jsp", "value": "" },
        { "id": "c2", "command": "type", "target": "name=username", "value": "testuser" },
        { "id": "c3", "command": "type", "target": "name=password", "value": "testpass" },
        { "id": "c4", "command": "click", "target": "css=button[type='submit']", "value": "" }
      ]
    }
  ],
  "suites": [
    {
      "id": "suite-001",
      "name": "Default Suite",
      "persistSession": false,
      "parallel": false,
      "timeout": 300,
      "tests": ["test-001", "test-002"]
    }
  ],
  "urls": ["http://localhost:8080/mallmate/"],
  "plugins": []
}